# Postgres
DATABASE_URL=postgres://dle:dle@localhost:5432/dle

# Auth
JWT_SECRET=change-me-generate-a-real-random-secret

# Email (SMTP) — vérification de compte / reset mot de passe
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Cloudinary (CDN images) — un compte dédié, ne PAS réutiliser l'ancien
# secret qui a fuité dans l'historique git de la v1
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# URL publique du site (liens dans les emails, CORS, etc.)
FRONTEND_URL=http://localhost:3000

NODE_ENV=development
