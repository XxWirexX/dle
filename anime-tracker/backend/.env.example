# Copie ce fichier en .env et adapte les valeurs

PORT=4000
# Origine autorisee (le frontend Vite)
FRONTEND_URL=http://localhost:5174
# Secret pour signer les tokens JWT (mets une vraie valeur en prod)
JWT_SECRET=change-moi-en-prod

# Comptes crees automatiquement par `npm run seed`
ADMIN_USERNAME=moi
ADMIN_PASSWORD=admin1234
VIEWER_USERNAME=frere
VIEWER_PASSWORD=frere1234
